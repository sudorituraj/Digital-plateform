# Frontend environment variables (copy to .env.local for local development).
# Only put PUBLIC values here — anything prefixed VITE_ ends up in the browser bundle.
# Never put secrets or API keys in frontend env files.

# Shows the "Demo version" banner at the top of every page.
VITE_DEMO_MODE=true

# Shows small "Needs client confirmation" markers next to unverified facts.
VITE_SHOW_CONFIRMATION_MARKERS=true

# Backend API base URL. Locally "/api" is proxied by Vite to http://localhost:8010.
# In production set it to the deployed API, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api
