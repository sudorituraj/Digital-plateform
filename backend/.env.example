# Backend settings. Copy to .env for local development. NEVER commit .env.

# "development" or "production". Production refuses to start with unsafe settings.
APP_ENV=development

# MongoDB. Locally: mongodb://localhost:27017 — in production, your MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=saran_demo

# Long random secret used to sign sessions and hash OTPs.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# OTP delivery: "demo" shows the code on screen (no SMS, no cost). "sms" needs a provider (not built yet).
OTP_MODE=demo

# Session cookie. Must be true in production (HTTPS only).
COOKIE_SECURE=false

# Only needed if the frontend is served from a different domain than the API (comma-separated).
# Locally leave empty — Vite proxies /api so everything is same-origin.
CORS_ORIGINS=

# Set true only when deployed behind a hosting proxy that sets X-Forwarded-For.
TRUST_PROXY=false
